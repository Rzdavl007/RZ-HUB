local function humanoid()
    local char = player.Character
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function addButton(text, callback)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -4, 0, 42)
    b.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Text = text
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 14
    b.Parent = list
    round(b)
    b.Activated:Connect(callback)
    return b
end

toggle.Activated:Connect(function()
    main.Visible = not main.Visible
end)

close.Activated:Connect(function()
    main.Visible = false
end)

-- Speed ON/OFF
local speedOn = false
addButton("Speed: OFF", function()
    speedOn = not speedOn
    local h = humanoid()
    if h then h.WalkSpeed = speedOn and 32 or 16 end
end)

-- Super Jump ON/OFF
local jumpOn = false
addButton("Super Jump: OFF", function()
    jumpOn = not jumpOn
    local h = humanoid()
    if h then
        h.UseJumpPower = true
        h.JumpPower = jumpOn and 100 or 50
    end
end)

-- Curar
addButton("Curar jogador", function()
    local h = humanoid()
    if h then h.Health = h.MaxHealth end
end)

-- Restaurar
addButton("Restaurar atributos", function()
    speedOn = false
    jumpOn = false
    local h = humanoid()
    if h then
        h.WalkSpeed = 16
        h.UseJumpPower = true
        h.JumpPower = 50
    end
end)

-- Arrastar botao no PC e celular
local dragging = false
local moved = false
local startPos
local startButtonPos
local activeTouch

toggle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        moved = false
        startPos = input.Position
        startButtonPos = toggle.Position
        if input.UserInputType == Enum.UserInputType.Touch then
            activeTouch = input
        end
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input == activeTouch) then
        local delta = input.Position - startPos
        if delta.Magnitude > 8 then moved = true end
        toggle.Position = UDim2.new(
            startButtonPos.X.Scale,
            startButtonPos.X.Offset + delta.X,
            startButtonPos.Y.Scale,
            startButtonPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input == activeTouch then
        dragging = false
        activeTouch = nil
    end
end)

